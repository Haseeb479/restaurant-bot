# ─────────────────────────────────────────────────────────────────────────────
# Restaurant Bot — environment template
# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# The Laravel app AND the Node bot both read this single .env file.
# PRODUCTION: set APP_ENV=production and APP_DEBUG=false before exposing publicly.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="Restaurant Bot"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Karachi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Database (shared by Laravel and the bot) ─────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=restaurant_bot
DB_USERNAME=root
DB_PASSWORD=

# ── Session / cache / queue ──────────────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# The session cookie is the admin/owner login. PRODUCTION (behind HTTPS): set
# this to true, or the cookie travels in clear text on every request.
SESSION_SECURE_COOKIE=false
# Keeps the cookie off cross-site POSTs, and out of reach of JavaScript.
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@restaurantbot.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Super-admin panel ────────────────────────────────────────────────────────
# REQUIRED. Set a strong, unique password — do NOT ship a shared/default value.
ADMIN_PASSWORD=

# ── WhatsApp bot control server ──────────────────────────────────────────────
# Port the Node bot's internal HTTP control server listens on. It binds to
# 127.0.0.1 only — the dashboard reaches it through Laravel, never directly.
BOT_INTERNAL_PORT=3000
# URL Laravel uses to reach that control server (host + port must match the port above).
BOT_INTERNAL_API=http://127.0.0.1:3000
# REQUIRED. Shared secret Laravel sends as `X-Bot-Token` and the bot demands on
# every request. The control server can hand out the WhatsApp pairing QR and send
# messages as the restaurant, so it refuses to start without this. Use the SAME
# value here and wherever the bot process reads its environment.
# Generate:  php -r "echo bin2hex(random_bytes(32));"
BOT_INTERNAL_TOKEN=

# ── Groq AI (chat replies + menu image/Excel OCR) — https://console.groq.com/keys
GROQ_API_KEY=
# Optional: comma-separated model fallback order. Leave unset to use the built-in
# defaults in bot/src/ai/GroqClient.js. See https://console.groq.com/docs/models
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,llama-3.3-70b-versatile
# Per-customer throttle between AI calls, in milliseconds.
REQUEST_DELAY_MS=2000

# ── Owner notifications & optional Google Sheets webhook ─────────────────────
# Owner WhatsApp number with country code, no "+" (e.g. 923001234567).
OWNER_PHONE=
# Optional HTTPS webhook to mirror orders to a Google Sheet (Apps Script URL).
# Must be https on port 443 and resolve to a public address — order data
# (customer phone, address, chat excerpt) is POSTed to it from the server, so
# internal/loopback/metadata targets are refused. A per-restaurant value set in
# the dashboard's Settings page takes precedence over this one.
GOOGLE_SHEET_WEBHOOK=

# ── EvolutionAPI v2 Multi-Tenant WhatsApp Bot ────────────────────────────────
EVOLUTION_BASE_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=foodio_evolution_secret_key_2026
