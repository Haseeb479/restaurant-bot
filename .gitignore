# Environment files (SENSITIVE - NEVER COMMIT)
.env
.env.*
!.env.example
.env.llm
env.llm
*.env

# WhatsApp Session Auth & Cache (SENSITIVE TOKENS)
.wwebjs_auth/
.wwebjs_cache/
session-*/

# Logs & Debugging
*.log
logs/
logs
storage/logs/*.log

# Dependencies
/node_modules/
/vendor/
cloudflared.exe

# Database Files
database/*.sqlite
database/*.sqlite-journal

# Compiled Views & Sessions
storage/framework/sessions/*
!storage/framework/sessions/.gitkeep
storage/framework/views/*
!storage/framework/views/.gitkeep
storage/framework/cache/*
!storage/framework/cache/.gitkeep

# Uploaded Media
# NOTE: .htaccess must stay tracked — it is the rule that stops uploads from
# being executed, so it has to exist on a fresh deploy.
public/uploads/*
!public/uploads/.gitkeep
!public/uploads/.htaccess
!public/uploads/menus/.gitkeep
public/menus/*
!public/menus/.gitkeep

# OS / Editor Artifacts
.DS_Store
Thumbs.db
/.fleet
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
.phpunit.result.cache
_ide_helper.php
Homestead.json
Homestead.yaml

# Build & Vite Output
/public/build
/public/hot
/public/storage
